# Copy to backend/.env. Restart Django after changing providers.
AI_PROVIDER=dinov3
# DINOv3 defaults: ml_models/dinov3, auto device (CUDA then CPU), five results.
AI_DINOV3_MODEL_DIR=ml_models/dinov3
AI_DINOV3_DEVICE=auto
AI_DINOV3_TOP_K=5
# Paths relative to backend/, or absolute paths. CPU requires no GPU.
AI_LOCAL_CHECKPOINT=model_artifacts/banglafoodnet/banglafoodnet_finetuned.pth
AI_LOCAL_DEVICE=cpu
# Cloud alternatives: AI_PROVIDER=openai or gemini, with the matching key.
# Leave AI_PROVIDER empty to turn recognition off.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: leave blank to use the provider default model.
AI_VISION_MODEL=
AI_TIMEOUT_SECONDS=30
